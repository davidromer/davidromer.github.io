---
import Base from "../layouts/Base.astro";
import { experienciaProfesional, experienciaDocente } from "../lib/perfil";
const bloques = [
  { id: "profesional", etiqueta: "// Trayectoria", titulo: "Experiencia profesional", datos: experienciaProfesional },
  { id: "docente", etiqueta: "// Academia", titulo: "Experiencia docente", datos: experienciaDocente },
] as const;
---
<Base titulo="Experiencia" descripcion="Trayectoria profesional y docente: desarrollo de software, bases de datos y enseñanza universitaria.">
  <h1>Experiencia</h1>
  <p class="lead">
    Más de diez años desarrollando software, administrando bases de datos y enseñando programación.
  </p>
  {bloques.map((b) => (
    <section class="seccion" aria-labelledby={b.id}>
      <p class="etiqueta">{b.etiqueta}</p>
      <h2 id={b.id}>{b.titulo}</h2>
      <div class="cuadricula-2">
        {b.datos.map((x) => (
          <article class="card">
            <div class="card-cuerpo">
              <h3>{x.cargo}</h3>
              <p class="centro">{x.empresa}</p>
              <p class="periodo">{x.periodo}</p>
              <ul class="logros">{x.logros.map((l) => <li>{l}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</Base>
